rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'admin@gmail.com' || request.auth.token.email == 'admin.homemaid@gmail.com' || request.auth.token.email == 'aarshpatel175@gmail.com');
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /bookings/{bookingId} {
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
